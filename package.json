{
  "name": "@categori/studio-contracts",
  "version": "0.4.0",
  "description": "Provider-neutral contracts for local and hosted AI studios",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.js",
    "./applications": "./src/applications.js",
    "./document-evaluations": "./src/document-evaluations.js",
    "./evaluations": "./src/evaluations.js",
    "./gateway": "./src/gateway.js",
    "./manifests": "./src/manifests.js",
    "./otel-genai": "./src/otel-genai.js",
    "./projects": "./src/projects.js",
    "./releases": "./src/releases.js",
    "./schemas/document-evaluation-result.schema.json": "./schemas/document-evaluation-result.schema.json",
    "./schemas/document-review-decision.schema.json": "./schemas/document-review-decision.schema.json",
    "./schemas/document-set-manifest.schema.json": "./schemas/document-set-manifest.schema.json",
    "./schemas/evaluation-rubric.schema.json": "./schemas/evaluation-rubric.schema.json",
