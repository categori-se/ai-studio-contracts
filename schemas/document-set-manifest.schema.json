{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:categori:studio:document-set-manifest:v1",
  "title": "Studio versioned document-set manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/slug"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "media_type", "version_id", "etag", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "uri": {"$ref": "#/$defs/safeUri"},
          "media_type": {
            "enum": ["text/plain", "text/markdown", "text/html", "application/json", "application/pdf"]
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!null$)(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          },
          "etag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          },
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeUri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://(?![^/?#]*@)[^?#]+$"
    }
  }
}
