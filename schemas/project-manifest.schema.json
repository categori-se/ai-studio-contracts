{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/studio/project-manifest.schema.json",
  "title": "Studio project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "repository", "defaultBranch", "commands", "modelPolicy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "repository": {"type": "string", "minLength": 1, "maxLength": 500},
    "defaultBranch": {"type": "string", "minLength": 1, "maxLength": 100},
    "dataSensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "install": {"type": "string", "maxLength": 500},
        "checks": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "build": {"type": "string", "maxLength": 500}
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["best_quality", "balanced_cost", "local_only", "no_external_data", "project_default"]}
      }
    }
  }
}
