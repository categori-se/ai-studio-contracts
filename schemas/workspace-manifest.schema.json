{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:categori:studio:workspace-manifest:v1",
  "title": "Studio workspace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "projects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=[\\s\\S]*\\S)(?!/)(?![A-Za-z]:)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))[\\s\\S]+\\.(?:[jJ][sS][oO][nN]|[yY][aA]?[mM][lL])$"
          }
        }
      }
    }
  }
}
